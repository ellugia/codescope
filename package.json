{
  "name": "codescope-bridge",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only local MCP bridge for explicitly configured repositories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellugia/codescope.git"
  },
  "type": "module",
  "bin": {
    "codescope": "bin/codescope.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "README.es.md",
    "bin/",
    "chatgpt/",
    "config.example.json",
    "docs/README.md",
    "docs/user-guide.en.md",
    "docs/user-guide.es.md",
    "scripts/codescope-*.ps1",
    "scripts/doctor.mjs",
    "scripts/self-check.mjs",
    "scripts/tunnel-*.ps1",
    "scripts/tunnel-runtime.ps1",
    "src/"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "cli": "node bin/codescope.mjs",
    "check": "node scripts/self-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "baseline": "node scripts/capture-baseline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  }
}
